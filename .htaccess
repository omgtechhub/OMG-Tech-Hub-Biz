# ─────────────────────────────────────────────────────────────────────────────
#  Project-root guard  —  OMG Tech Hub
# ─────────────────────────────────────────────────────────────────────────────
#  On the live host the webroot is the built dist/ folder, so this file mainly
#  protects the DEV tree under XAMPP, where http://localhost/omgtechhub/ serves
#  the whole project directory — including .env, package.json and node_modules.
#  It is harmless if deployed as well.

# ── Dotfiles: .env, .env.development, .git, … ────────────────────────────────
#  Apache blocks .ht* by default and nothing else, so .env is served as plain
#  text without this.
<FilesMatch "(?i)^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Build, dependency and notes files that are not meant to be fetched ───────
<FilesMatch "(?i)\.(env|json|lock|log|md|txt|ts|tsx|sql|bak|old|orig|save|swp|dist|ini|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── …but robots.txt and the web manifest must stay reachable ─────────────────
<FilesMatch "(?i)^(robots\.txt|site\.webmanifest|manifest\.json|sitemap\.xml)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# ── Source and dependency trees ──────────────────────────────────────────────
RedirectMatch 404 (?i)^/.*/(node_modules|src|\.sanity|\.claude|\.git)(/|$)

# ── No directory listings anywhere ───────────────────────────────────────────
Options -Indexes

# ── Baseline response headers ────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ServerSignature Off
